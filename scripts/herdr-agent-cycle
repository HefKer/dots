#!/bin/sh
# Focus an agent the way herdr's next_agent, previous_agent and focus_agent do, but
# land on its prompt pane (scripts/claude-prompt) when its tab has one, zoomed over
# Claude as it was opened. Run by herdr's ctrl+alt+j/k, ctrl+alt+1..9 and ctrl+alt+a.
#
# Usage: herdr-agent-cycle next|prev|attention|1..9
#   next, prev  the agent after or before the current one, in sidebar order
#   1..9        the agent at that place in the sidebar
#   attention   the next agent waiting on you: a blocked one (a question or an
#               approval) if any, otherwise one that finished unseen (done)
case "$1" in
  next | prev | attention | [1-9]) ;;
  *)
    echo "usage: herdr-agent-cycle next|prev|attention|1..9" >&2
    exit 2
    ;;
esac

# The agent-focus plugin's view (herdr/plugins/agent-focus) narrows the sidebar, but
# not the agent list read here, so apply the same filter while it is on.
focus=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/herdr/plugins/hefker.agent-focus/mode" 2>/dev/null)

target=$(herdr api snapshot | jq -r --arg mode "$1" --arg focus "${focus:-off}" '
  .result.snapshot as $s
  | ($s.workspaces | map({ (.workspace_id): .number }) | add) as $ws
  | ($s.tabs | map({ (.tab_id): .number }) | add) as $tabs
  | [$s.agents | to_entries[]
     | .value + { order: [$ws[.value.workspace_id], $tabs[.value.tab_id], .key] }]
  | sort_by(.order)
  | if $focus == "on" then
      map(select(.workspace_id == $s.focused_workspace_id or (.agent_status | IN("blocked", "done"))))
    else . end
  # The current agent is the focused pane, or else the first agent in the focused
  # tab, which is where the prompt pane leaves it.
  | . as $agents
  | ((map(.pane_id) | index($s.focused_pane_id))
     // (map(.tab_id) | index($s.focused_tab_id))) as $cur
  # The first of $pool after the current agent, wrapping; the first of $pool when
  # the current agent is not an agent at all.
  | def after($pool; $step):
      ($agents | length) as $n
      | [range(1; $n + 1) | (($cur // (if $step > 0 then -1 else 0 end)) + . * $step + $n * $n) % $n]
      | map($agents[.] | select(.pane_id | IN($pool[].pane_id)))
      | .[0].pane_id // empty;
  if $mode == "next" then after($agents; 1)
  elif $mode == "prev" then after($agents; -1)
  elif $mode == "attention" then
    (map(select(.agent_status == "blocked"))) as $blocked
    | if ($blocked | length) > 0 then after($blocked; 1)
      else after(map(select(.agent_status == "done")); 1) end
  else .[($mode | tonumber) - 1].pane_id // empty end')
[ -n "$target" ] || exit 0

herdr agent focus "$target" >/dev/null
tab=$(herdr pane get "$target" | jq -r .result.pane.tab_id)
prompt=$(herdr pane list --workspace "${target%%:*}" |
  jq -r --arg tab "$tab" '[.result.panes[] | select(.tab_id == $tab and .label == "prompt")][0].pane_id // empty')
[ -n "$prompt" ] && herdr pane zoom "$prompt" --on >/dev/null
exit 0
