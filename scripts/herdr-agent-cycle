#!/bin/sh
# Focus the next or previous agent in sidebar order, as herdr's next_agent and
# previous_agent do, but land on the agent's prompt pane (scripts/claude-prompt) when
# its tab has one, zoomed over Claude as it was opened. Run by herdr's ctrl+alt+j/k.
# Usage: herdr-agent-cycle next|prev
step=1
[ "$1" = prev ] && step=-1

target=$(herdr api snapshot | jq -r --argjson step "$step" '
  .result.snapshot as $s
  | ($s.workspaces | map({ (.workspace_id): .number }) | add) as $ws
  | ($s.tabs | map({ (.tab_id): .number }) | add) as $tabs
  | [$s.agents | to_entries[]
     | .value + { order: [$ws[.value.workspace_id], $tabs[.value.tab_id], .key] }]
  | sort_by(.order) as $agents
  | ($agents | length) as $n
  | select($n > 0)
  # The current agent is the focused pane, or else the first agent in the focused
  # tab, which is where the prompt pane leaves it.
  | ([$agents | to_entries[] | select(.value.pane_id == $s.focused_pane_id) | .key][0]
     // [$agents | to_entries[] | select(.value.tab_id == $s.focused_tab_id) | .key][0]) as $cur
  | if $cur == null then (if $step > 0 then 0 else $n - 1 end)
    else ($cur + $step + $n) % $n end
  | $agents[.].pane_id')
[ -n "$target" ] || exit 0

herdr agent focus "$target" >/dev/null
tab=$(herdr pane get "$target" | jq -r .result.pane.tab_id)
prompt=$(herdr pane list --workspace "${target%%:*}" |
  jq -r --arg tab "$tab" '[.result.panes[] | select(.tab_id == $tab and .label == "prompt")][0].pane_id // empty')
[ -n "$prompt" ] && herdr pane zoom "$prompt" --on >/dev/null
exit 0
