#!/usr/bin/env python3
"""Ask Jev, TypeSafe AI's decision model, a typed question about some text or an image.

Jev doesn't generate text: it judges a `state` and answers with probabilities.
The state comes from --state or stdin; for box, it is the image, named `image`.

    jev noul "Is this about billing?" < mail.txt         # prints 0.98; exit 1 below --threshold
    jev choice "Which tone?" calm angry "excited=eager or enthusiastic" -s "..."
    jev score "How urgent?" "can wait" "this week" "today" -s "..."
    jev box shot.png "the table in `image`" --noul "Is there a table in `image`?"
                                  # prints "left top right bottom confidence" (0-1 fractions),
                                  # then the noul's probability; exit 1 below --threshold
    jev ask < request.json                                # any questions, raw response
    jev models

Exit status: 0 on an answer (for noul: a yes), 1 for a noul below the threshold,
2 on any failure. API reference: https://docs.typesafe.ai/llms.txt
"""

import argparse
import json
import os
import struct
import subprocess
import uuid
import sys
import time
import urllib.error
import urllib.request

BASE_URL = os.environ.get("TYPESAFE_BASE_URL", "https://api.typesafe.ai")
# Pinned: the jev-latest alias can move to a model that answers differently, which
# shifts every threshold tuned against this one.
MODEL = os.environ.get("TYPESAFE_DEFAULT_MODEL", "jev-1.14.0")
SECRET_FILE = "/run/secrets/jev-key"
SOPS_FILE = os.path.expanduser("~/nixos/main/secrets/shared.yaml")
TIMEOUT = 20
RETRIES = 2  # on 429 (rate limit) and 529 (overloaded)


class Failure(Exception):
    pass


def api_key():
    if key := os.environ.get("TYPESAFE_API_KEY"):
        return key
    try:
        with open(SECRET_FILE, encoding="utf-8") as handle:
            return handle.read().strip()
    except OSError:
        pass
    # Not deployed as a secret on this host: decrypt it, with the age key from Bitwarden
    # unless the caller set another source. rbw asks for the vault password if locked.
    env = dict(os.environ)
    if not any(name in env for name in ("SOPS_AGE_KEY", "SOPS_AGE_KEY_FILE", "SOPS_AGE_KEY_CMD")):
        env["SOPS_AGE_KEY_CMD"] = "rbw get sops-age-key"
    try:
        done = subprocess.run(
            ["sops", "decrypt", "--extract", '["jev-key"]', SOPS_FILE],
            capture_output=True, text=True, env=env, check=False,
        )
    except OSError as error:
        raise Failure(f"no API key: set TYPESAFE_API_KEY ({error})") from None
    if done.returncode or not done.stdout.strip():
        reason = (done.stderr.strip().splitlines() or ["sops printed nothing"])[0]
        raise Failure(f"no API key: set TYPESAFE_API_KEY, or fix sops ({reason})")
    return done.stdout.strip()


def explain(body):
    """The message in an error body, whose `detail` is a string, an object or a list."""
    try:
        detail = json.loads(body).get("detail")
    except (ValueError, AttributeError):
        return body.strip()[:300]
    if isinstance(detail, list):  # 422: one entry per invalid field
        return "; ".join(
            f"{'.'.join(map(str, item.get('loc', [])))}: {item.get('msg')}"
            for item in detail if isinstance(item, dict)
        )
    return detail if isinstance(detail, str) else json.dumps(detail)


def call(path, body=None, images=None):
    """POST `body` as JSON, or as multipart with `images` ({part name: (format, bytes)})."""
    headers = {"Authorization": f"Bearer {api_key()}", "User-Agent": "jev-cli"}
    if images:
        data, headers["Content-Type"] = multipart(body, images)
        headers["TypeSafe-Danger-Zone-Images"] = "true"
    else:
        data = json.dumps(body).encode() if body is not None else None
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(BASE_URL + path, data=data, headers=headers)
    for attempt in range(RETRIES + 1):
        try:
            with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
                return json.load(response)
        except urllib.error.HTTPError as error:
            if error.code in (429, 529) and attempt < RETRIES:
                try:
                    wait = float(error.headers.get("retry-after", ""))
                except ValueError:
                    wait = 2**attempt
                time.sleep(min(wait, 10))
                continue
            text = error.read().decode("utf-8", "replace")
            raise Failure(f"HTTP {error.code}: {explain(text)}") from None
        except (urllib.error.URLError, TimeoutError, ValueError) as error:
            raise Failure(f"request failed: {getattr(error, 'reason', error)}") from None


def multipart(body, images):
    """The `request` JSON part first, as the API requires, then one part per image."""
    boundary = uuid.uuid4().hex
    parts = [("request", "application/json", json.dumps(body).encode(), "")]
    parts += [(name, f"image/{fmt}", data, f'; filename="{name}.{fmt}"') for name, (fmt, data) in images.items()]
    out = b""
    for name, kind, data, filename in parts:
        out += (
            f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"{filename}\r\n'
            f"Content-Type: {kind}\r\n\r\n"
        ).encode() + data + b"\r\n"
    return out + f"--{boundary}--\r\n".encode(), f"multipart/form-data; boundary={boundary}"


# The API never resizes, and one image out of range fails the whole request.
IMAGE_SIDE = (280, 1568)
IMAGE_PIXELS = 2_458_624
IMAGE_BYTES = 16 * 1024 * 1024


def image_size(data):
    """(format, width, height) from a PNG's IHDR or a JPEG's first SOF marker."""
    if data[:8] == b"\x89PNG\r\n\x1a\n" and data[12:16] == b"IHDR":
        return ("png", *struct.unpack(">II", data[16:24]))
    if data[:2] == b"\xff\xd8":
        at = 2
        while at + 9 <= len(data) and data[at] == 0xFF:
            marker, length = data[at + 1], struct.unpack(">H", data[at + 2 : at + 4])[0]
            if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
                height, width = struct.unpack(">HH", data[at + 5 : at + 9])
                return ("jpeg", width, height)
            at += 2 + length
    raise Failure("not a PNG or JPEG image")


def load_image(path):
    try:
        with open(path, "rb") as handle:
            data = handle.read()
    except OSError as error:
        raise Failure(f"can't read {path}: {error.strerror}") from None
    fmt, width, height = image_size(data)
    low, high = IMAGE_SIDE
    if not (low <= width <= high and low <= height <= high) or width * height > IMAGE_PIXELS:
        raise Failure(f"{path} is {width}x{height}: each side must be {low}-{high} px, at most {IMAGE_PIXELS} px in all")
    if len(data) > IMAGE_BYTES:
        raise Failure(f"{path} is over 16 MiB")
    return fmt, data


def box(args):
    """One request: a Box over the image, plus the optional companion Noul (Box always answers)."""
    fmt, data = load_image(args.image)
    ref = f"image-{uuid.uuid4()}"
    questions = {"box": {"type": "box", "instructions": args.instructions}}
    if args.noul:
        questions["noul"] = {"type": "noul", "instructions": args.noul}
    body = {
        "model": args.model or MODEL,
        "state": {"image": ref},
        "assets": {ref: {"type": "image", "part": "image"}},
        "questions": questions,
    }
    if args.save_request:
        with open(args.save_request, "w", encoding="utf-8") as handle:
            json.dump({"image": os.path.abspath(args.image), "request": body}, handle, indent=2)
    answers = call("/v1/systemone", body, {"image": (fmt, data)}).get("answers", {})
    try:
        edges = answers["box"]["box"]
        yes = answers["noul"]["noul"] if args.noul else None
    except (KeyError, TypeError):
        raise Failure(f"unexpected answer: {json.dumps(answers)[:300]}") from None
    if args.json:
        print(json.dumps(answers, ensure_ascii=False))
    else:
        confidence = answers["box"].get("confidence")
        print(*(edges[side] for side in ("left", "top", "right", "bottom")), "null" if confidence is None else confidence)
        if args.noul:
            print(yes)
    if args.noul and yes < args.threshold:
        return 1
    return 0


def ask(state, questions, model=None):
    """The `answers` of one request: {name: {"type": ..., "noul"|"choice"|"score": ..., ...}}."""
    reply = call("/v1/systemone", {"model": model or MODEL, "state": state, "questions": questions})
    return reply["answers"]


def state_from(args):
    if args.state is not None:
        return args.state
    if sys.stdin.isatty():
        raise Failure("no state: pass --state or pipe the text in")
    return sys.stdin.read()


def options(pairs):
    """`name` or `name=description` arguments as Choice criteria."""
    criteria = {}
    for pair in pairs:
        name, _, description = pair.partition("=")
        criteria[name] = description or None  # null: judged by its name alone
    return criteria


def parse_args():
    parser = argparse.ArgumentParser(
        prog="jev", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-s", "--state", help="the text to judge (default: stdin)")
    common.add_argument("--model", help=f"model ID or alias (default: {MODEL})")
    common.add_argument("--json", action="store_true", help="print the whole answer as JSON")
    commands = parser.add_subparsers(dest="command", required=True)

    noul = commands.add_parser("noul", parents=[common], help="yes/no: prints the probability of yes")
    noul.add_argument("question")
    noul.add_argument("-t", "--threshold", type=float, default=0.5, help="exit 1 below this (default 0.5)")

    choice = commands.add_parser("choice", parents=[common], help="one of the options: prints its name")
    choice.add_argument("question")
    choice.add_argument("options", nargs="+", metavar="option[=description]")

    score = commands.add_parser("score", parents=[common], help="a rubric: prints the expected level, from 0")
    score.add_argument("question")
    score.add_argument("levels", nargs="+", metavar="level", help="descriptions, lowest first (at most 10)")

    find = commands.add_parser("box", help="locate something in an image: prints its edges as 0-1 fractions")
    find.add_argument("image", help="PNG or JPEG, each side 280-1568 px; named `image` in the questions")
    find.add_argument("instructions", help="what to find, e.g. \"the table in `image`\"")
    find.add_argument("--noul", metavar="QUESTION", help="also ask this yes/no in the same request (a box always answers)")
    find.add_argument("-t", "--threshold", type=float, default=0.5, help="exit 1 when the noul is below this (default 0.5)")
    find.add_argument("--model", help=f"model ID or alias (default: {MODEL}; images need jev-1.14 or later)")
    find.add_argument("--json", action="store_true", help="print the answers as JSON")
    find.add_argument("--save-request", metavar="FILE", help="write the request JSON (without the image bytes) here")

    raw = commands.add_parser("ask", help="request JSON on stdin (model optional), response JSON out")
    raw.add_argument("--model", help=f"model when the request names none (default: {MODEL})")
    commands.add_parser("models", help="list the models")
    return parser.parse_args()


def main():
    args = parse_args()
    if args.command == "models":
        print(json.dumps(call("/v1/models"), indent=2))
        return 0
    if args.command == "box":
        return box(args)
    if args.command == "ask":
        try:
            request = json.load(sys.stdin)
        except ValueError as error:
            raise Failure(f"stdin is not JSON: {error}") from None
        request.setdefault("model", args.model or MODEL)
        print(json.dumps(call("/v1/systemone", request), indent=2, ensure_ascii=False))
        return 0

    question = {"type": args.command, "instructions": args.question}
    if args.command == "choice":
        question["criteria"] = options(args.options)
    elif args.command == "score":
        question["criteria"] = args.levels
    answer = ask(state_from(args), {"q": question}, args.model)["q"]
    print(json.dumps(answer, ensure_ascii=False) if args.json else answer[args.command])
    if args.command == "noul":
        return 0 if answer["noul"] >= args.threshold else 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Failure as failure:
        print(f"jev: {failure}", file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
