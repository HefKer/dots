#!/usr/bin/env bash
set -euo pipefail

mkdir -p "$HOME/.local/share/ytdl"
# Log only valid video IDs, normalized to a watch URL: wl-clean puts them in JS on youtube.com.
for arg in "$@"; do
    grep -oP '(?:[?&]v=|youtu\.be/|/(?:shorts|embed|live)/)\K[A-Za-z0-9_-]{11}(?![A-Za-z0-9_-])' <<< "$arg" | head -n1 \
        | sed 's|^|https://www.youtube.com/watch?v=|' >> "$HOME/.local/share/ytdl/downloaded.txt" || true
done

yt-dlp \
    --write-subs \
    --write-auto-subs \
    --embed-subs \
    --convert-subs srt \
    --embed-metadata \
    --merge-output-format mkv \
    -o "$HOME/Videos/%(title)s.%(ext)s" \
    "$@"

find "$HOME/Videos" -maxdepth 1 -name "*.srt" -delete
