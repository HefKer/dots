#!/usr/bin/env bash
# Quick run (niri's Mod+;): a floating WezTerm on a fish prompt in vi normal mode, so the
# clipboard is a `p` away. Nothing runs until Enter. Once the command ends, its output
# stays until a key is pressed. If it fails or runs longer than 10 s, a notification says so.
#
# Saved commands, name<TAB>command in fish's quick-run.tsv: `s` in normal mode picks one
# onto the command line, unrun (Ctrl+D in the picker deletes one); `s` on the closing
# screen names and saves the one just run.
#
# One at a time. Mod+; again:
#   - while a command runs in the focused quick run: hides it on the "hidden" workspace;
#     its end is announced (a success closes it, a failure offers Show)
#   - while one is hidden: brings it to the workspace you're on
#   - otherwise: focuses the open one, or opens one
#
#   quick-run          the Mod+; action above
#   quick-run show     bring a hidden quick run back, else focus it (the notification's Show)
#   quick-run hidden   exit 0 if the quick run is hidden (asked by its own fish)
#   quick-run forget NAME   delete the saved command NAME (the picker's Ctrl+D)
set -euo pipefail
app=quick-run
hidden_ws=hidden
running=${XDG_RUNTIME_DIR:-/tmp}/quick-run.running
self=$(realpath "$0")
list=${XDG_CONFIG_HOME:-$HOME/.config}/fish/quick-run.tsv

if [[ ${1:-} == forget ]]; then
	[[ -f $list ]] || exit 0
	N=$2 awk -F '\t' '$1 != ENVIRON["N"]' "$list" >"$list.tmp"
	mv "$list.tmp" "$list"
	exit
fi

win=$(niri msg -j windows | jq -c --arg a "$app" 'first(.[] | select(.app_id == $a)) // empty')
id=$(jq -r '.id // empty' <<<"$win")
hidden_id=$(niri msg -j workspaces | jq -r --arg n "$hidden_ws" '.[] | select(.name == $n) | .id')
is_hidden() { [[ -n $id && $(jq -r .workspace_id <<<"$win") == "$hidden_id" ]]; }

show() {
	# The active workspace of the focused output. Moving to another output lands on its
	# active workspace; on the same output, an index is that output's.
	local out ws_out idx
	out=$(niri msg -j focused-output | jq -r .name)
	ws_out=$(niri msg -j workspaces | jq -r --arg i "$hidden_id" '.[] | select((.id | tostring) == $i) | .output')
	if [[ $ws_out != "$out" ]]; then
		niri msg action move-window-to-monitor --id "$id" "$out"
	else
		idx=$(niri msg -j workspaces | jq -r --arg o "$out" '.[] | select(.output == $o and .is_active) | .idx')
		niri msg action move-window-to-workspace --window-id "$id" --focus false "$idx"
	fi
	niri msg action focus-window --id "$id"
}

case ${1:-} in
hidden)
	is_hidden
	exit
	;;
show)
	[[ -n $id ]] || exit 0
	if is_hidden; then show; else niri msg action focus-window --id "$id"; fi
	exit
	;;
esac

if [[ -n $id ]]; then
	if is_hidden; then
		show
	elif [[ $(jq -r .is_focused <<<"$win") == true && -e $running ]]; then
		niri msg action move-window-to-workspace --window-id "$id" --focus false "$hidden_ws"
	else
		niri msg action focus-window --id "$id"
	fi
	exit
fi

# A marker left by a quick run that was killed mid-command.
rm -f "$running"

# -C runs after the user's config, so abbrs, functions, atuin and the clipboard binds
# (fish conf.d/22-clipboard.fish) are loaded. A marker file says a command is running.
init='
set -g __quick_run_list $QUICK_RUN_LIST
# Installed at the first prompt, once fish_vi_key_bindings has run, so it is not erased.
function __quick_run_normal --on-event fish_prompt
    functions -e __quick_run_normal
    set -g fish_bind_mode default
    bind -M default s __quick_run_pick
end
# s: a saved command onto the command line, unrun.
function __quick_run_pick
    if not test -s $__quick_run_list
        # __fish_echo prints below the line and moves the prompt under it; a plain echo is painted over.
        __fish_echo echo (set_color --dim)"No saved commands yet: s on the closing screen saves one"(set_color normal)
        return
    end
    set -l pick (fzf --delimiter \t --prompt "saved> " --no-multi --header "Ctrl+D deletes" \
        --with-shell "bash -c" --bind "ctrl-d:execute-silent($QUICK_RUN_SELF forget {1})+reload(cat $__quick_run_list)" \
        <$__quick_run_list)
    and commandline -r -- (string split -m1 -f2 \t -- $pick)
    commandline -f repaint
end
# name<TAB>command, a name already listed replaced.
function __quick_run_save -a name cmd
    set -l keep
    test -f $__quick_run_list
    and for l in (cat $__quick_run_list)
        test "$(string split -m1 -f1 \t -- $l)" = "$name"; or set -a keep $l
    end
    printf "%s\n" $keep (printf "%s\t%s" $name $cmd) >$__quick_run_list
end
function __quick_run_start --on-event fish_preexec
    touch $QUICK_RUN_RUNNING
end
function __quick_run_done --on-event fish_postexec
    set -l st $status
    rm -f $QUICK_RUN_RUNNING
    set -l secs (math --scale 0 $CMD_DURATION / 1000)
    set -l cmd (string join " " -- (string split \n -- $argv[1]))
    if $QUICK_RUN_SELF hidden
        if test $st -eq 0
            notify-send -a "Quick run" "Done after $secs s" "$cmd" &
            disown
            exit
        end
        # notify-send -A waits for the click; setsid keeps it alive past this window.
        setsid -f bash -c "notify-send -a \"Quick run\" -A show=Show \"Exit \$1\" \"\$2\" | grep -qx show && exec \"\$0\" show" \
            $QUICK_RUN_SELF $st "$cmd" >/dev/null 2>&1
    else if test $st -ne 0
        notify-send -a "Quick run" "Exit $st" "$cmd" &
    else if test $CMD_DURATION -gt 10000
        notify-send -a "Quick run" "Done after $secs s" "$cmd" &
    end
    echo
    set_color --dim; echo "[exit $st, $secs s] s saves · any key closes"; set_color normal
    # The fish read builtin is vi-mode aware and swallows Esc; a raw byte read takes any key.
    set -l key (bash -c "read -rsn1 k; printf %s \"\$k\"" </dev/tty)
    if test "$key" = s
        read -P "name: " name
        set name (string trim -- (string replace -a \t " " -- "$name"))
        if test -n "$name"
            __quick_run_save $name "$cmd"
            exit
        end
        set_color --dim; echo "not saved · any key closes"; set_color normal
        bash -c "read -rsn1" </dev/tty
    end
    exit
end
'

cd "$HOME"
QUICK_RUN_SELF=$self QUICK_RUN_RUNNING=$running QUICK_RUN_LIST=$list exec wezterm start --always-new-process --class "$app" --cwd "$HOME" -- \
	fish -C "$init"
