#!/usr/bin/env bash
# Throwaway qutebrowser instance for testing config in a live page, driven from
# the shell. Separate basedir, so the user's running browser and profile stay
# out of it.

set -euo pipefail

usage() {
	cat <<EOF
usage: qute-sandbox <command>

  start [--profile] [--cdp] [url]
                           start the instance and wait for the page to load
                           --profile: use a copy of the real data dir (cookies,
                           logins, generated scripts), never the original
                           --cdp: open the DevTools protocol on a free local
                           port and print its URL (tab list at <url>/json/list),
                           for heap snapshots, tracing and the like
  eval <js>                print the value of a JS expression in the active tab;
                           a Promise is awaited, a string prints raw, anything
                           else as JSON, a throw exits 1. Wrap statements in an
                           IIFE. No eval(), so it works under a strict CSP
  cmd <:command>           send a qutebrowser command, e.g. ':reload -f'
  serve <dir>              serve <dir> over local HTTP for test pages and print
                           its URL; replaces an earlier serve, and stop ends it
  mem [secs]               RSS of each of the instance's processes; with secs,
                           a line of totals every secs seconds until killed
  stop                     stop this instance and its server, remove its basedir

Basedir: $B, with the instance's log in log. config/ has
links to the repo's files, so edits apply on ':config-source' or the next start;
replace a link to swap something (e.g. config/greasemonkey) without touching
the repo. autoconfig.yml and other files qutebrowser writes are copies.

One instance at a time. Opens a real window; QT_QPA_PLATFORM=offscreen at start
keeps it off the screen.
EOF
}

die() {
	printf 'qute-sandbox: %s\n' "$*" >&2
	exit 1
}

B=${TMPDIR:-/tmp}/qute-sandbox-$UID
repo=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")

# A PID recorded in $1, checked against its command line containing $2 so a
# recycled PID never counts as ours. Never look a process up by pattern: a
# pkill -f or pgrep -f also matches any shell whose command line mentions it.
alive() {
	local cmdline
	[[ -r $1 ]] || return 1
	cmdline=$({ tr '\0' ' ' <"/proc/$(<"$1")/cmdline"; } 2>/dev/null) || return 1
	[[ $cmdline == *"$2"* ]]
}

running() { alive "$B/pid" "--basedir $B "; }

free_port() {
	python3 -Ic 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])'
}

# Ends the process group a setsid'd PID leads: TERM, then KILL after 10s.
end_group() {
	local i
	kill -- "-$1" 2>/dev/null || return 0
	for i in {1..100}; do
		kill -0 -- "-$1" 2>/dev/null || return 0
		sleep 0.1
	done
	kill -KILL -- "-$1" 2>/dev/null || true
}

# Without a live instance, qutebrowser --basedir would start a new one.
send() {
	running || die "not running, use: qute-sandbox start"
	qutebrowser --basedir "$B" "$@" >>"$B/log" 2>&1
}

# The tab's title as the browser sees it. Print it once it starts with $1, polling
# $2 times, about a second each.
read_title() {
	local i title
	for ((i = 0; i < $2; i++)); do
		rm -f "$B/title"
		send ":spawn --userscript $B/dump"
		for _ in {1..20}; do
			[[ -e $B/title ]] && break
			sleep 0.05
		done
		title=$(cat "$B/title" 2>/dev/null) || title=
		if [[ $title == "$1"* ]]; then
			printf '%s\n' "$title"
			return 0
		fi
		sleep 0.2
	done
	return 1
}

# :jseval output never reaches the shell, so the page publishes the value through
# document.title and a userscript reads it from $QUTE_TITLE. Titles have their
# whitespace collapsed and are capped near 4096 characters, so the value travels
# as base64 in chunks of chunk_size: mark:index:length:status:chunk, length being
# the whole base64 text's.
#
# The code runs in the page's main world, so the page can rewrite the title or
# the globals the code uses: every field is validated before use, and the chunk
# count comes from length here rather than from the page. A hostile page gets a
# garbled result or none, never a command run.
chunk_size=3000
max_length=$((8 * 1024 * 1024))

# Checks result title $1 for chunk $3 of the run marked $2 and sets length,
# status and chunk from it; length and status must match what an earlier chunk
# set. Dies naming the first field that doesn't fit.
parse_chunk() {
	local title=$1 mark=$2 index=$3 f count want
	[[ $title =~ ^([^:]*):([^:]*):([^:]*):([^:]*):(.*)$ ]] ||
		die "malformed result: not mark:index:length:status:chunk"
	f=("${BASH_REMATCH[@]}")
	[[ ${f[1]} == "$mark" ]] || die "bad result mark"
	[[ ${f[2]} == "$index" ]] || die "bad result index: expected $index"
	# Digits only before any arithmetic, which would expand a[$(cmd)]; 10# so
	# a leading zero isn't octal.
	if ! [[ ${f[3]} =~ ^[0-9]{1,9}$ ]] || ((10#${f[3]} > max_length)); then
		die "bad result length: not an integer up to $max_length"
	fi
	[[ -z $length || $((10#${f[3]})) == "$length" ]] || die "bad result length: changed mid-result"
	length=$((10#${f[3]}))
	[[ ${f[4]} == ok || ${f[4]} == error ]] || die "bad result status: not ok or error"
	[[ -z $status || ${f[4]} == "$status" ]] || die "bad result status: changed mid-result"
	status=${f[4]}
	[[ ${f[5]} =~ ^[A-Za-z0-9+/=]*$ ]] || die "bad result chunk $index: not base64"
	chunk=${f[5]}
	count=$(((length + chunk_size - 1) / chunk_size))
	((count > 0)) || count=1
	((index < count)) || die "bad result index: $index past the last chunk"
	want=$((index < count - 1 ? chunk_size : length - index * chunk_size))
	((${#chunk} == want)) || die "bad result chunk $index: ${#chunk} characters, expected $want"
}

# $2 is how long to poll.
eval_js() {
	local mark=qute-sandbox-$RANDOM$RANDOM i count length='' status='' chunk title out
	{
		cat <<EOF
(() => {
	const mark = "$mark";
	const save = document.title;
	const publish = (status, text) => {
		const bytes = new TextEncoder().encode(text);
		const b64 = btoa(Array.from(bytes, (b) => String.fromCharCode(b)).join(""));
		const size = $chunk_size;
		const chunk = (i) => mark + ":" + i + ":" + b64.length + ":" + status + ":" +
			b64.slice(i * size, (i + 1) * size);
		window.__quteSandbox = { save, chunk };
		document.title = chunk(0);
	};
	Promise.resolve()
		.then(() => (
EOF
		printf '%s\n' "$1"
		cat <<'EOF'
		))
		.then((v) => (typeof v === "string" ? v : (JSON.stringify(v) ?? String(v))))
		.then((v) => publish("ok", v), (e) => publish("error", String(e)));
})();
EOF
	} >"$B/eval.js"
	send ":jseval --quiet --world=main --file $B/eval.js"

	title=$(read_title "$mark:0:" "${2:-15}") ||
		die "no result (syntax error in the JS, or a page that keeps rewriting its title?)"
	parse_chunk "$title" "$mark" 0
	out=$chunk
	count=$(((length + chunk_size - 1) / chunk_size))
	for ((i = 1; i < count; i++)); do
		send ":jseval --quiet --world=main document.title=window.__quteSandbox.chunk($i)"
		title=$(read_title "$mark:$i:" 15) || die "lost the result at chunk $i of $count"
		parse_chunk "$title" "$mark" "$i"
		out+=$chunk
	done
	send ":jseval --quiet --world=main document.title=window.__quteSandbox.save"

	if [[ $status == ok ]]; then
		base64 -d <<<"$out"
		echo
	else
		{
			base64 -d <<<"$out"
			echo
		} >&2
		return 1
	fi
}

populate() {
	local f real_data=${XDG_DATA_HOME:-$HOME/.local/share}/qutebrowser
	mkdir -m 700 "$B"
	mkdir -p "$B"/{config,data,cache,runtime}

	for f in "$repo"/qutebrowser/.config/qutebrowser/*; do
		case ${f##*/} in
		autoconfig.yml | quickmarks | bookmarks | qsettings) cp -r "$f" "$B/config/" ;;
		*.sync-conflict-* | __pycache__) ;;
		*) ln -s "$f" "$B/config/" ;;
		esac
	done

	if [[ $1 == profile ]]; then
		[[ -d $real_data ]] || die "no profile at $real_data"
		# Exit 24: files vanished mid-copy, expected if the real browser is running.
		rsync -a --exclude 'webengine/Service Worker-bak' --exclude 'webengine/WebStorage' \
			--exclude 'webengine/File System' --exclude 'webengine/Shared Dictionary' \
			--exclude sessions --exclude userscripts "$real_data/" "$B/data/" || (($? == 24))
	fi
	ln -s "$repo/qutebrowser/.local/share/qutebrowser/userscripts" "$B/data/userscripts"

	cat >"$B/dump" <<EOF
#!/bin/sh
printf '%s\n' "\$QUTE_TITLE" >"$B/title.tmp" && mv "$B/title.tmp" "$B/title"
EOF
	chmod +x "$B/dump"
}

cmd_start() {
	local mode=fresh url=about:blank ready='document.readyState === "complete"' i cdp=
	while (($#)); do
		case $1 in
		--profile) mode=profile ;;
		--cdp) cdp=$(free_port) ;;
		-*) die "unknown option: $1" ;;
		*) url=$1 ;;
		esac
		shift
	done
	[[ $url == about:blank ]] || ready+=' && location.href !== "about:blank"'

	running && die "already running (pid $(<"$B/pid")), use: qute-sandbox stop"
	alive "$B/serve.pid" http.server && end_group "$(<"$B/serve.pid")"
	rm -rf "$B"
	populate "$mode"

	# setsid: survive the caller's shell, and give stop a process group to clean up.
	if [[ -n $cdp ]]; then
		echo "$cdp" >"$B/cdp-port"
		export QTWEBENGINE_REMOTE_DEBUGGING=127.0.0.1:$cdp
	fi
	setsid qutebrowser --basedir "$B" "$url" </dev/null >>"$B/log" 2>&1 &
	echo $! >"$B/pid"

	for i in {1..300}; do
		compgen -G "$B/runtime/ipc-*" >/dev/null && break
		running || {
			tail -n 20 "$B/log" >&2
			rm -rf "$B"
			die "qutebrowser exited during startup"
		}
		sleep 0.1
	done
	compgen -G "$B/runtime/ipc-*" >/dev/null || die "no IPC socket after 30s, see $B/log"

	# A title set before the page commits is lost with the old document, so give
	# up on a probe early and send a new one.
	for i in {1..30}; do
		[[ $(eval_js "$ready" 2 2>/dev/null) == true ]] && break
		sleep 0.2
	done
	((i < 30)) || echo "qute-sandbox: page still not loaded after 60s" >&2
	echo "$B"
	[[ -z $cdp ]] || echo "cdp: http://127.0.0.1:$cdp"
}

# Lives in the basedir, so start's cleanup and stop both reach it.
cmd_serve() {
	local dir port i
	dir=$(readlink -f "$1") && [[ -d $dir ]] || die "not a directory: $1"
	running || die "not running, use: qute-sandbox start"
	alive "$B/serve.pid" http.server && end_group "$(<"$B/serve.pid")"
	port=$(free_port)
	setsid python3 -I -m http.server -b 127.0.0.1 -d "$dir" "$port" </dev/null >>"$B/serve.log" 2>&1 &
	echo $! >"$B/serve.pid"
	for i in {1..50}; do
		(echo >"/dev/tcp/127.0.0.1/$port") 2>/dev/null && break
		alive "$B/serve.pid" http.server || die "server exited, see $B/serve.log"
		sleep 0.1
	done
	echo "http://127.0.0.1:$port/"
}

# Selects by process group, which start's setsid made the instance's PID, so
# renderers count and no command line pattern is involved.
mem_rows() {
	local p type rss
	for p in $(pgrep -g "$(<"$B/pid")"); do
		rss=$(awk '/^VmRSS/{print int($2/1024)}' "/proc/$p/status" 2>/dev/null) || continue
		type=$(tr '\0 ' '[\n*]' <"/proc/$p/cmdline" 2>/dev/null | sed -n 's/^--type=//p')
		printf '%s %s %s\n' "$p" "${type:-browser}" "${rss:-0}"
	done
}

cmd_mem() {
	running || die "not running, use: qute-sandbox start"
	if (($# == 0)); then
		printf '%-8s %-14s %s\n' PID TYPE RSS_MB
		mem_rows | sort -k3 -nr | xargs -r printf '%-8s %-14s %s\n'
		return
	fi
	[[ $1 =~ ^[0-9]+$ ]] || die "usage: qute-sandbox mem [secs]"
	while running; do
		mem_rows | awk -v t="$(date +%T)" '
			{ total += $3; if ($2 == "renderer" && $3 > top) top = $3 }
			END { printf "%s total=%dMB top_renderer=%dMB procs=%d\n", t, total, top, NR }'
		sleep "$1"
	done
}

cmd_stop() {
	local pid i
	[[ -e $B ]] || return 0
	alive "$B/serve.pid" http.server && end_group "$(<"$B/serve.pid")"
	if running; then
		pid=$(<"$B/pid")
		kill "$pid"
		for i in {1..100}; do
			running || break
			sleep 0.1
		done
		kill -KILL -- "-$pid" 2>/dev/null || true
	fi
	rm -rf "$B"
}

# Sourced, as by the tests: definitions only.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

case ${1-} in
start)
	shift
	cmd_start "$@"
	;;
eval)
	(($# == 2)) || die "usage: qute-sandbox eval <js>"
	running || die "not running, use: qute-sandbox start"
	eval_js "$2"
	;;
cmd)
	shift
	[[ ${1-} == :* ]] || die "usage: qute-sandbox cmd <:command>"
	send "$*"
	;;
serve)
	(($# == 2)) || die "usage: qute-sandbox serve <dir>"
	cmd_serve "$2"
	;;
mem)
	shift
	cmd_mem "$@"
	;;
stop) cmd_stop ;;
-h | --help | help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
