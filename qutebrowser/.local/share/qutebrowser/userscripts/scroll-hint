#!/usr/bin/env bash
# Hint scrollable elements and iframes; the chosen one takes focus, so j/k, d/u
# and PgUp/PgDn scroll it. See js/scroll-hint.js in the config dir.
#
# A userscript only to run two commands in a row: jseval takes the rest of its
# line as code, ;; included, so a bind can't chain anything after it.
#
# Usage: :spawn --userscript scroll-hint
printf '%s\n' \
  "jseval -q -f $QUTE_CONFIG_DIR/js/scroll-hint.js" \
  "hint scrollable run jseval -q qbScrollFocus('{hint-url}')" \
  >"$QUTE_FIFO"
