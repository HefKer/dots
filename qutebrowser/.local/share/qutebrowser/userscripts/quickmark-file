#!/usr/bin/env python3
"""Save the current page as a quickmark, with its group already typed.

Usage:
    :spawn --userscript quickmark-file

Quickmark names here start with a group word (`csa calendar`, `gh stars`), which
is what makes them completable. This asks Jev, TypeSafe's decision model, which
existing group the page belongs to, then opens a fuzzel prompt holding that
group for the rest of the name to be typed. A second question in the same
request asks whether the page shares a site or a subject with any group at
all, since a Choice always picks one: a page that fits none, or any failure to reach Jev, leaves the
prompt empty.

Jev is sent the page's title and its URL without the query string, plus each
group's name with a few of its marks' names and hosts.
"""

import json
import os
import shutil
import subprocess
from collections import defaultdict
from pathlib import Path
from urllib.parse import urlsplit

import qutefifo

MIN_MARKS = 2  # marks sharing a first word before it counts as a group
EXAMPLES = 4  # marks described per group
MIN_FITS = 0.7  # probability that the page shares a site or subject with a group, below which none is prefilled
MIN_PROBABILITY = 0.5  # of the picked group, below which it isn't prefilled


def msg(level, text):
    qutefifo.message(level, f"quickmark-file: {text}")


def bare(url):
    """The URL without its query and fragment, which can hold tokens."""
    parts = urlsplit(url)
    return f"{parts.scheme}://{parts.netloc}{parts.path}"


def groups(path):
    """{group: its first marks, as "name (host)"} for every first word several names share."""
    marks = defaultdict(list)
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return {}
    for line in lines:
        name, _, url = line.rpartition(" ")
        if name and " " in name:
            marks[name.split()[0].lower()].append((name, urlsplit(url).hostname or ""))
    described = {}
    for group, members in sorted(marks.items()):
        if len(members) >= MIN_MARKS:
            described[group] = [f"{name} ({host})" for name, host in members[:EXAMPLES]]
    return described


def guess(url, title, options):
    """The group Jev picks for the page, or None."""
    if not options:
        return None
    request = {
        "state": {"page": {"url": bare(url), "title": title}, "bookmark_groups": options},
        "questions": {
            "group": {
                "type": "choice",
                "instructions": "Which of the user's bookmark groups does `page` belong in?",
                "criteria": {
                    group: f"Marks in this group: {', '.join(marks)}" for group, marks in options.items()
                },
            },
            # Either makes a group fit, and each is one judgment: asked as a single
            # "same site or subject" question, a GitHub repo scored under the bar.
            "same_site": {
                "type": "noul",
                "instructions": "Is `page` on the same website as the marks in one of `bookmark_groups`?",
            },
            "same_subject": {
                "type": "noul",
                "instructions": "Is `page` about the same subject as the marks in one of `bookmark_groups`?",
            },
        },
    }
    jev = shutil.which("jev") or os.path.expanduser("~/dots/scripts/jev")
    try:
        done = subprocess.run(
            [jev, "ask"], input=json.dumps(request), capture_output=True, text=True, check=False
        )
        answers = json.loads(done.stdout)["answers"]
        answer = answers["group"]
        fits = max(answers["same_site"]["noul"], answers["same_subject"]["noul"])
    except (OSError, ValueError, KeyError):
        reason = done.stderr.strip() if "done" in locals() else "jev not found"
        msg("warning", f"no group suggested ({reason or 'no answer'})")
        return None
    group = answer["choice"]
    if fits < MIN_FITS or answer["probabilities"].get(group, 0) < MIN_PROBABILITY:
        return None
    return group


def main():
    url, title = os.environ["QUTE_URL"], os.environ.get("QUTE_TITLE", "")
    group = guess(url, title, groups(Path(os.environ["QUTE_CONFIG_DIR"]) / "quickmarks"))
    done = subprocess.run(
        ["fuzzel", "--dmenu", "--prompt-only", "quickmark: ", "--search", f"{group} " if group else ""],
        capture_output=True, text=True, check=False,
    )
    name = " ".join(done.stdout.split())
    if done.returncode or not name:
        return  # dismissed
    qutefifo.send(f"quickmark-add {qutefifo.url_arg(url)} {qutefifo.text_arg(name)}")
    msg("info", f"saved as {name}")


if __name__ == "__main__":
    main()
