#!/usr/bin/env python3
"""Port uBlock Origin's popup defenses from the adblock lists into a greasemonkey script.

Usage:
    :spawn --userscript ubo-scriptlets
    ubo-scriptlets            (outside qutebrowser; prints instead of messaging)

qutebrowser's adblock applies the network rules of the lists in privacy.py to requests,
but has no popup blocker and skips every scriptlet (##+js) line. uBO stops popunders and
the tab redirects that come with them in two ways this script ports:

- Scriptlets: every `nowoif` and `set-cookie` rule, run only on the hosts it names.
- Popup filtering: every network rule typed `popup`, `all`, `doc` or `document`,
  checked on every site against the URL a page tries to open in a new window, whether
  through window.open, a target=_blank link or form, or a frame's own window.open.
  qutebrowser's adblock would only block the new tab's page load, leaving the tab.

The lists are read from the `c.content.blocking.adblock.lists` assignment in
privacy.py, following uBO's `!#include` and `!#if` directives the way desktop
Chromium uBO would. The output goes to qutebrowser's data dir, beside the adblock
cache, since it is regenerated state rather than config.
"""

import ast
import json
import os
import re
import sys
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urljoin

CONFIG_DIR = Path(os.environ.get("QUTE_CONFIG_DIR", "~/.config/qutebrowser")).expanduser()
DATA_DIR = Path(os.environ.get("QUTE_DATA_DIR", "~/.local/share/qutebrowser")).expanduser()
OUTPUT = DATA_DIR / "greasemonkey" / "ubo-scriptlets.js"
LISTS_TARGET = "c.content.blocking.adblock.lists"

# uBO's `!#if` tokens as desktop Chromium uBO sets them; any other token is false
TRUE_TOKENS = {"ext_ublock", "env_chromium", "cap_user_stylesheet"}

SCRIPTLETS = {
    "nowoif": "nowoif",
    "no-window-open-if": "nowoif",
    "window.open-defuser": "nowoif",
    "set-cookie": "set-cookie",
}

SCRIPTLET_RE = re.compile(r"^(.*?)(#@?#)\+js\((.*)\)$")
HOST_RE = re.compile(r"^[a-z0-9.*_-]+$")
PURE_HOST_RE = re.compile(r"^\|\|([a-z0-9.-]+)\^\|?$")

# network rule types that apply to a popup's URL
POPUP_TYPES = {"popup", "all", "doc", "document"}
# other request types: harmless beside a popup type, since only the popup half is used
OTHER_TYPES = {
    "script", "image", "stylesheet", "css", "xhr", "xmlhttprequest", "frame",
    "subdocument", "media", "font", "object", "ping", "websocket", "other", "beacon",
}
REGEX_SPECIAL = set(".+?${}()|[]\\/")


def message(level, text):
    fifo = os.environ.get("QUTE_FIFO")
    if fifo:
        with open(fifo, "w") as f:
            f.write(f"message-{level} {json.dumps('ubo-scriptlets: ' + text)}\n")
    else:
        print(text, file=sys.stderr if level == "error" else sys.stdout)


def read_list_urls():
    tree = ast.parse((CONFIG_DIR / "privacy.py").read_text())
    for node in ast.walk(tree):
        if isinstance(node, ast.Assign) and any(
            ast.unparse(t) == LISTS_TARGET for t in node.targets
        ):
            return ast.literal_eval(node.value)
    raise SystemExit(f"no {LISTS_TARGET} assignment in privacy.py")


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "qutebrowser ubo-scriptlets"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return resp.read().decode("utf-8", "replace")


def eval_condition(expr):
    """Evaluate a `!#if` expression: tokens joined by !, &&, || and parentheses."""
    py = re.sub(r"[A-Za-z_][A-Za-z0-9_]*", lambda m: str(m[0] in TRUE_TOKENS), expr)
    py = py.replace("&&", " and ").replace("||", " or ").replace("!", " not ")
    try:
        return bool(eval(py, {"__builtins__": {}}))
    except SyntaxError:
        return False


def preprocess(text):
    """Yield the lines uBO would keep, plus `!#include` targets, after `!#if` blocks."""
    stack = []  # one bool per open block: is it active
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("!#if "):
            stack.append(eval_condition(line[5:]))
        elif line == "!#else":
            if stack:
                stack[-1] = not stack[-1]
        elif line == "!#endif":
            if stack:
                stack.pop()
        elif all(stack):
            yield line


def load_all(urls):
    """Fetch every list and the lists they include, returning {url: [lines]}."""
    texts, pending, seen = {}, list(urls), set(urls)
    with ThreadPoolExecutor(8) as pool:
        while pending:
            batch, pending = pending, []
            for url, text in zip(batch, pool.map(fetch, batch)):
                lines = list(preprocess(text))
                texts[url] = lines
                for line in lines:
                    if line.startswith("!#include "):
                        child = urljoin(url, line.split(None, 1)[1])
                        if child not in seen:
                            seen.add(child)
                            pending.append(child)
    return texts


def split_hosts(s, sep=","):
    """Split a host list on `sep`, keeping /regex/ entries whole."""
    hosts, i = [], 0
    while i < len(s):
        neg = s[i] == "~"
        j = i + 1 if neg else i
        if j < len(s) and s[j] == "/":
            end = s.find("/" + sep, j + 1)
            end = len(s) if end == -1 else end + 1
        else:
            end = s.find(sep, j)
            end = len(s) if end == -1 else end
        hosts.append(s[i:end])
        i = end + 1
    return [h for h in hosts if h]


def split_args(s):
    """Split scriptlet arguments the way uBO does: commas, `\\,` escapes, quoted args."""
    args, i, n = [], 0, len(s)
    while i < n:
        while i < n and s[i] == " ":
            i += 1
        buf = []
        if i < n and s[i] in "'\"`":
            quote, i = s[i], i + 1
            while i < n and s[i] != quote:
                if s[i] == "\\" and i + 1 < n and s[i + 1] == quote:
                    i += 1
                buf.append(s[i])
                i += 1
            i = s.find(",", i)
            i = n if i == -1 else i
            args.append("".join(buf))
        else:
            while i < n and s[i] != ",":
                if s[i] == "\\" and i + 1 < n and s[i + 1] == ",":
                    i += 1
                buf.append(s[i])
                i += 1
            args.append("".join(buf).strip())
        i += 1
    return args


class Table:
    """Hosts, entities (`name.*`) and hostname regexes, each mapped to rule ids."""

    def __init__(self):
        self.hosts, self.entities, self.regexes = {}, {}, {}

    def add(self, host, rule_id):
        if host.startswith("/") and host.endswith("/") and len(host) > 2:
            target, key = self.regexes, host[1:-1]
        elif host.endswith(".*"):
            target, key = self.entities, host[:-2]
        else:
            target, key = self.hosts, host
        ids = target.setdefault(key, [])
        if rule_id not in ids:
            ids.append(rule_id)

    def dump(self):
        return {"h": self.hosts, "e": self.entities, "r": list(self.regexes.items())}


def parse_scriptlet(m, rule_id, include, exclude, exempt, stats):
    host_part, sep, body = m.groups()
    args = split_args(body)
    exception = sep == "#@#"
    if exception and not args:
        rid = -1  # `#@#+js()` turns off every scriptlet on the host
    else:
        name = SCRIPTLETS.get(args[0].removesuffix(".js")) if args else None
        if name is None:
            return
        rid = rule_id(name, args[1:])
    hosts = split_hosts(host_part)
    if not hosts or hosts == ["*"]:
        # uBO only injects scriptlets for named hosts
        stats["generic"] += 1
        return
    stats["scriptlets"] += 1
    for host in hosts:
        neg = host.startswith("~")
        host = host[1:] if neg else host
        is_regex = host.startswith("/") and host.endswith("/")
        if not is_regex and not HOST_RE.match(host):
            continue
        if exception:
            exempt.add(host, rid)
        else:
            (exclude if neg else include).add(host, rid)


def pattern_to_regex(pat):
    """Translate an adblock URL pattern into a JS regex source, as uBO matches it."""
    if len(pat) > 2 and pat.startswith("/") and pat.endswith("/"):
        return pat[1:-1]
    out = ""
    if pat.startswith("||"):
        out, pat = r"^[a-z][a-z0-9.+-]*:\/\/(?:[^\/?#]*\.)?", pat[2:]
    elif pat.startswith("|"):
        out, pat = "^", pat[1:]
    end = ""
    if pat.endswith("|"):
        end, pat = "$", pat[:-1]
    for ch in pat:
        if ch == "*":
            out += ".*"
        elif ch == "^":
            out += "(?:[^%.0-9a-z_-]|$)"
        elif ch in REGEX_SPECIAL:
            out += "\\" + ch
        else:
            out += ch
    return out + end


def parse_network(line):
    """Parse a network rule that applies to popups, returning (is_exception, host, rule).

    `host` is set for a plain `||host^` pattern, which the script looks up by hostname
    instead of running a regex. Rules with modifiers this port can't honor return None.
    """
    exception = line.startswith("@@")
    body = line[2:] if exception else line
    pat, _, opts = body.rpartition("$")
    if not pat and not opts:
        return None
    rule, popup = {}, False
    for opt in opts.split(","):
        opt = opt.strip()
        neg = opt.startswith("~")
        name, _, value = (opt[1:] if neg else opt).partition("=")
        if name in POPUP_TYPES:
            if neg:
                return None
            popup = True
        elif name in OTHER_TYPES or name == "reason":
            continue
        elif name in ("third-party", "3p", "strict3p"):
            rule["tp"] = 0 if neg else 1
        elif name in ("first-party", "1p", "strict1p"):
            rule["tp"] = 1 if neg else 0
        elif name in ("domain", "from", "to"):
            key = "t" if name == "to" else "d"
            for host in split_hosts(value, "|"):
                if host.startswith("~"):
                    rule.setdefault("n" + key, []).append(host[1:])
                else:
                    rule.setdefault(key, []).append(host)
        elif name == "match-case":
            rule["mc"] = 1
        elif name == "important":
            rule["i"] = 1
        else:
            return None
    if not popup:
        return None
    pat = pat.strip()
    m = PURE_HOST_RE.match(pat)
    if m:
        return exception, m[1], rule
    if pat not in ("", "*"):
        rule["re"] = pattern_to_regex(pat)
    return exception, None, rule


def build(texts):
    rules, rule_ids = [], {}
    include, exclude, exempt = Table(), Table(), Table()
    stats = {"scriptlets": 0, "generic": 0, "popup": 0}
    network, badfilters = [], set()

    def rule_id(name, args):
        key = json.dumps([name, args])
        if key not in rule_ids:
            rule_ids[key] = len(rules)
            rules.append([name, args])
        return rule_ids[key]

    for lines in texts.values():
        for line in lines:
            if not line or line[0] in "![":
                continue
            if "+js(" in line:
                m = SCRIPTLET_RE.match(line)
                if m:
                    parse_scriptlet(m, rule_id, include, exclude, exempt, stats)
                continue
            if "##" in line or "#@#" in line or "#?#" in line or "#$#" in line or "$" not in line:
                continue
            if ",badfilter" in line or "$badfilter" in line:
                badfilters.add(re.sub(r"(,badfilter|badfilter,?)", "", line).rstrip("$"))
            else:
                network.append(line)

    popup = {"block": {"h": {}, "l": []}, "allow": {"h": {}, "l": []}}
    seen = set()
    for line in network:
        if line in badfilters or line in seen:
            continue
        seen.add(line)
        parsed = parse_network(line)
        if parsed is None:
            continue
        exception, host, rule = parsed
        target = popup["allow" if exception else "block"]
        if host:
            target["h"].setdefault(host, []).append(rule)
        else:
            target["l"].append(rule)
        stats["popup"] += 1

    data = {
        "rules": rules,
        "include": include.dump(),
        "exclude": exclude.dump(),
        "exempt": exempt.dump(),
    }
    return data, popup, stats


# The scriptlet bodies follow uBO's no-window-open-if and set-cookie (uBlock
# src/js/resources/scriptlets.js), minus the debug logging. nowoif's iframe decoy is
# replaced by its fallback: a proxy of the current window that reports itself open.
TEMPLATE = r"""// ==UserScript==
// @name         ubo-scriptlets
// @namespace    https://github.com/hefker/dots
// @version      2.0.0
// @description  uBlock Origin's popup filtering, nowoif and set-cookie, ported from the lists in privacy.py.
// @match        *://*/*
// @exclude      *://*.youtube.com/*
// @exclude      *://*.youtube-nocookie.com/*
// @exclude      *://accounts.google.com/*
// @run-at       document-start
// @grant        none
// @license      MIT
// ==/UserScript==

// GENERATED by the ubo-scriptlets userscript at /*GENERATED_AT*/. Don't edit; rerun it with `cu`.
// Sources:
/*SOURCES*/

(function () {
  'use strict';

  // an about:blank frame has no hostname of its own; uBO treats it as its parent's
  function frameHost() {
    if (location.hostname) return location.hostname.replace(/\.$/, '');
    try {
      const origins = location.ancestorOrigins;
      if (origins && origins.length) return new URL(origins[0]).hostname;
    } catch {}
    return '';
  }
  const host = frameHost();

  // a filter for example.com also covers its subdomains
  function suffixesOf(hostname) {
    const labels = hostname.split('.');
    return labels.map((_, i) => labels.slice(i).join('.'));
  }
  // a `name.*` entity stands for name plus any public suffix; without a suffix list,
  // allow the dropped tail to be one or two labels (`.to`, `.co.uk`)
  function entitiesOf(hostname) {
    const labels = hostname.split('.');
    const out = [];
    for (let i = 0; i < labels.length; i++) {
      for (let j = Math.max(i + 1, labels.length - 2); j < labels.length; j++) {
        out.push(labels.slice(i, j).join('.'));
      }
    }
    return out;
  }
  function hostIn(hostname, list) {
    return list.some((entry) =>
      entry.endsWith('.*')
        ? entitiesOf(hostname).includes(entry.slice(0, -2))
        : hostname === entry || hostname.endsWith('.' + entry),
    );
  }
  // registrable domain, approximated: two labels, or three under a short second level
  function baseDomain(hostname) {
    const labels = hostname.split('.');
    const n = labels.length > 2 && labels.at(-1).length === 2 && labels.at(-2).length <= 3 ? 3 : 2;
    return labels.slice(-n).join('.');
  }

  // ---- scriptlets, for the hosts their filters name ----

  const nowoifRules = [];

  function activeScriptlets() {
    if (!host) return [];
    const data = JSON.parse(/*SCRIPTLETS*/);
    const suffixes = suffixesOf(host);
    const entities = entitiesOf(host);
    function lookup(table) {
      const ids = new Set();
      const add = (map, key) => Object.hasOwn(map, key) && map[key].forEach((id) => ids.add(id));
      suffixes.forEach((s) => add(table.h, s));
      entities.forEach((e) => add(table.e, e));
      for (const [re, list] of table.r) {
        try {
          if (new RegExp(re).test(host)) list.forEach((id) => ids.add(id));
        } catch {}
      }
      return ids;
    }
    const exempt = lookup(data.exempt);
    if (exempt.has(-1)) return [];
    const exclude = lookup(data.exclude);
    return [...lookup(data.include)]
      .filter((id) => !exclude.has(id) && !exempt.has(id))
      .map((id) => data.rules[id]);
  }

  function toRegex(pattern) {
    if (pattern === '') return /^/;
    const m = /^\/(.+)\/([imsu]*)g?([imsu]*)$/.exec(pattern);
    if (!m) return new RegExp(pattern.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
    try {
      return new RegExp(m[1], m[2] + m[3] || undefined);
    } catch {
      return /^/;
    }
  }

  // collected here and applied by install(), so frames get them too
  function nowoif(pattern = '', delay = '') {
    const blockOnMatch = !pattern.startsWith('!');
    const re = toRegex(blockOnMatch ? pattern : pattern.slice(1));
    const noop = function () {};
    nowoifRules.push((win, args) => {
      if (re.test(Array.from(args).join(' ')) !== blockOnMatch) return undefined;
      console.debug('[ubo-scriptlets] nowoif blocked window.open:', ...args);
      if (delay === '') return null;
      // a delay means the page checks for a live popup, so hand back one that looks open
      return new Proxy(win, {
        get(target, prop) {
          if (prop === 'closed') return false;
          const value = Reflect.get(target, prop);
          return typeof value === 'function' ? noop : value;
        },
        set: Reflect.set,
      });
    });
  }

  const SAFE_COOKIE_VALUES = new Set([
    'accept', 'reject', 'accepted', 'rejected', 'notaccepted', 'allow', 'disallow',
    'deny', 'allowed', 'denied', 'approved', 'disapproved', 'checked', 'unchecked',
    'dismiss', 'dismissed', 'enable', 'disable', 'enabled', 'disabled', 'essential',
    'nonessential', 'forbidden', 'forever', 'hide', 'hidden', 'necessary', 'required',
    'ok', 'on', 'off', 'true', 't', 'false', 'f', 'yes', 'y', 'no', 'n', 'all', 'none',
    'functional', 'granted', 'done', 'decline', 'declined', 'closed', 'next',
    'mandatory', 'disagree', 'agree',
  ]);

  function getCookie(name) {
    for (const part of document.cookie.split(/\s*;\s*/)) {
      const pos = part.indexOf('=');
      if (pos !== -1 && part.slice(0, pos) === name) return part.slice(pos + 1).trim();
    }
  }

  function setCookie(name = '', value = '', path = '', ...extra) {
    if (name === '') return;
    const lower = value.toLowerCase();
    const unquoted = (/^("?)(.+)\1$/.exec(lower) || [])[2] || lower;
    if (!SAFE_COOKIE_VALUES.has(unquoted)) {
      if (!/^-?\d+$/.test(unquoted)) return;
      const n = parseInt(value, 10) || 0;
      if (n < -32767 || n > 32767) return;
    }
    const options = {};
    for (let i = 0; i + 1 < extra.length; i += 2) options[extra[i]] = extra[i + 1];
    if (/[^!#$&+\-.0-9A-Z[\]^_`a-z|~]/.test(name)) name = encodeURIComponent(name);
    if (/[^ -:<-[\]-~]/.test(value)) value = encodeURIComponent(value);
    const before = getCookie(name);
    if (before !== undefined && options.dontOverwrite) return;
    if (before === value && options.reload) return;
    if (path === '') path = '/';
    else if (path === 'none') path = '';
    if (path !== '' && path !== '/') return;
    document.cookie = name + '=' + value + (path === '/' ? '; path=/' : '');
    if (options.reload && getCookie(name) === value) window.location.reload();
  }

  const scriptlets = { nowoif: nowoif, 'set-cookie': setCookie };
  for (const [name, args] of activeScriptlets()) {
    try {
      scriptlets[name](...args);
    } catch (e) {
      console.debug('[ubo-scriptlets]', name, args, e);
    }
  }

  // ---- popup filtering, on every site ----

  // parsed on the first attempt to open a window, not on every page load
  let popupRules;
  const regexCache = new Map();

  function ruleMatches(rule, url, dest) {
    if (rule.tp !== undefined && (baseDomain(dest) !== baseDomain(host)) !== !!rule.tp) return false;
    if (rule.d && !hostIn(host, rule.d)) return false;
    if (rule.nd && hostIn(host, rule.nd)) return false;
    if (rule.t && !hostIn(dest, rule.t)) return false;
    if (rule.nt && hostIn(dest, rule.nt)) return false;
    if (rule.re === undefined) return true;
    let re = regexCache.get(rule);
    if (re === undefined) {
      try {
        re = new RegExp(rule.re, rule.mc ? '' : 'i');
      } catch {
        re = null;
      }
      regexCache.set(rule, re);
    }
    return re !== null && re.test(url);
  }

  function firstMatch(set, url, dest) {
    for (const s of suffixesOf(dest)) {
      if (!Object.hasOwn(set.h, s)) continue;
      const hit = set.h[s].find((rule) => ruleMatches(rule, url, dest));
      if (hit) return hit;
    }
    return set.l.find((rule) => ruleMatches(rule, url, dest));
  }

  function popupBlocked(rawUrl) {
    if (rawUrl === undefined || rawUrl === null || rawUrl === '') return false;
    let u;
    try {
      u = new URL(String(rawUrl), document.baseURI);
    } catch {
      return false;
    }
    if (u.protocol !== 'http:' && u.protocol !== 'https:') return false;
    popupRules ??= JSON.parse(/*POPUP*/);
    const hit = firstMatch(popupRules.block, u.href, u.hostname);
    if (!hit) return false;
    if (!hit.i && firstMatch(popupRules.allow, u.href, u.hostname)) return false;
    console.debug('[ubo-scriptlets] popup filter blocked:', u.href);
    return true;
  }

  function opensNewWindow(target, doc, ev) {
    if (ev && (ev.ctrlKey || ev.metaKey || ev.shiftKey || ev.button === 1)) return true;
    const base = doc && doc.querySelector('base[target]');
    const t = (target || (base && base.target) || '').toLowerCase();
    return t !== '' && t !== '_self' && t !== '_top' && t !== '_parent';
  }

  function blockedLink(el, ev) {
    const link = el && typeof el.closest === 'function' ? el.closest('a[href], area[href]') : null;
    return !!link && opensNewWindow(link.target, link.ownerDocument, ev) && popupBlocked(link.href);
  }

  function onClick(ev) {
    let el = ev.composedPath()[0];
    if (el && el.nodeType !== 1) el = el.parentElement;
    if (blockedLink(el, ev)) ev.preventDefault();
  }

  const installed = new WeakSet();

  function install(win) {
    try {
      if (installed.has(win)) return;
      installed.add(win);

      win.open = new Proxy(win.open, {
        apply(target, thisArg, args) {
          for (const rule of nowoifRules) {
            const result = rule(win, args);
            if (result !== undefined) return result;
          }
          if (popupBlocked(args[0])) return null;
          return Reflect.apply(target, thisArg, args);
        },
      });

      // hooks are Proxies so they keep a native toString: anti-adblock checks (YouTube's
      // among them) flag a page whose built-ins no longer read `[native code]`. Google's
      // sign-in sees through them anyway and flags the browser as insecure, so the
      // header keeps the script off accounts.google.com.
      const hook = (obj, name, apply) => {
        obj[name] = new Proxy(obj[name], { apply });
      };

      // links a script clicks, attached or not; detached ones never reach onClick
      hook(win.HTMLElement.prototype, 'click', (target, thisArg, args) => {
        if (blockedLink(thisArg)) return;
        return Reflect.apply(target, thisArg, args);
      });
      hook(win.EventTarget.prototype, 'dispatchEvent', (target, thisArg, args) => {
        const ev = args[0];
        if (ev && ev.type === 'click' && blockedLink(thisArg, ev)) return false;
        return Reflect.apply(target, thisArg, args);
      });
      hook(win.HTMLFormElement.prototype, 'submit', (target, thisArg, args) => {
        if (opensNewWindow(thisArg.target, thisArg.ownerDocument) && popupBlocked(thisArg.action)) {
          return;
        }
        return Reflect.apply(target, thisArg, args);
      });
      win.addEventListener('click', onClick, true);
      win.addEventListener('auxclick', onClick, true);

      // a fresh same-origin frame brings its own unpatched window.open, a common way
      // around overrides like this one, so patch each frame window the page reaches for
      for (const C of [win.HTMLIFrameElement, win.HTMLFrameElement, win.HTMLObjectElement]) {
        for (const prop of ['contentWindow', 'contentDocument']) {
          const desc = Object.getOwnPropertyDescriptor(C.prototype, prop);
          if (!desc || !desc.get) continue;
          Object.defineProperty(C.prototype, prop, {
            ...desc,
            get: new Proxy(desc.get, {
              apply(target, thisArg, args) {
                const value = Reflect.apply(target, thisArg, args);
                const child = prop === 'contentWindow' ? value : value && value.defaultView;
                if (child) install(child);
                return value;
              },
            }),
          });
        }
      }
    } catch {
      // a cross-origin frame's window can't be patched; its own copy of this script covers it
    }
  }

  install(window);
})();
"""


def render(scriptlets, popup, urls):
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    sources = "\n".join(f"//   {u}" for u in urls)
    compact = lambda d: json.dumps(json.dumps(d, separators=(",", ":")))
    return (
        TEMPLATE.replace("/*GENERATED_AT*/", stamp)
        .replace("/*SOURCES*/", sources)
        .replace("/*SCRIPTLETS*/", compact(scriptlets))
        .replace("/*POPUP*/", compact(popup))
    )


def main():
    urls = read_list_urls()
    try:
        texts = load_all(urls)
    except OSError as e:
        message("error", f"fetching lists failed: {e}")
        return 1
    scriptlets, popup, stats = build(texts)
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    tmp = OUTPUT.with_suffix(".tmp")
    tmp.write_text(render(scriptlets, popup, list(texts)))
    tmp.replace(OUTPUT)

    message(
        "info",
        f"{stats['scriptlets']} scriptlet and {stats['popup']} popup filters from {len(texts)} lists",
    )
    # includes are network rules too, and qutebrowser's adblock doesn't follow them
    missing = [u for u in texts if u not in urls]
    if missing:
        message("warning", "included lists missing from privacy.py: " + ", ".join(missing))
    if os.environ.get("QUTE_FIFO"):
        with open(os.environ["QUTE_FIFO"], "w") as f:
            f.write("greasemonkey-reload --quiet\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
