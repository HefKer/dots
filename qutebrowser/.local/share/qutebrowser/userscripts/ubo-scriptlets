  const css = [];
  function hide(selector, style) {
    css.push(`${selector}{${style}}`);
  }

  const scriptlets = {
    nowoif: nowoif,
    'set-cookie': setCookie,
    ra: removeAttr,
    rc: removeClass,
    'cookie-remover': cookieRemover,
    set: setConstant,
    'set-local-storage-item': setLocalStorageItem,
    css: hide,
  };
  for (const [name, args] of activeScriptlets()) {
    try {
      scriptlets[name](...args);
    } catch (e) {
      console.debug('[ubo-scriptlets]', name, args, e);
    }
  }
  if (css.length) {
    // one rule per element, so an invalid selector drops only its own rule
    const addSheet = () => {
      const sheet = document.createElement('style');
      sheet.textContent = css.join('\n');
