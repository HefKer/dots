  function setLocalStorageItem(key = '', raw = '') {
    const re = key.startsWith('/') ? toRegex(key) : null;
    const apply = () => {
      if (raw !== '$remove$') {
        const parsed = parseConstant(raw);
        if (!re && parsed && parsed.value !== undefined) localStorage.setItem(key, String(parsed.value));
        return;
