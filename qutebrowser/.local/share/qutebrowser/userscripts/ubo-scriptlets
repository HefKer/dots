        const domains = suffixesOf(location.hostname).flatMap((d) => ['; domain=' + d, '; domain=.' + d]);
        for (const d of ['', ...domains]) {
          document.cookie = `${name}=; max-age=0; path=/${d}`;
          document.cookie = `${name}=; max-age=0${d}`;
