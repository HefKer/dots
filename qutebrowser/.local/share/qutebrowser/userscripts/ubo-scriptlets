  // object on the way so the constant lands whenever the page creates it
  function setConstant(chain = '', raw = '') {
    const parsed = parseConstant(raw);
    if (!chain || parsed === null) return;
    const value = parsed.value;
    const trap = (owner, path) => {
      const dot = path.indexOf('.');
      const prop = dot === -1 ? path : path.slice(0, dot);
      const desc = Object.getOwnPropertyDescriptor(owner, prop);
      if (desc && !desc.configurable) return;
      if (dot === -1) {
        Object.defineProperty(owner, prop, { configurable: true, get: () => value, set() {} });
        return;
      }
      const rest = path.slice(dot + 1);
      let inner = owner[prop];
      if (inner instanceof Object) trap(inner, rest);
      Object.defineProperty(owner, prop, {
        configurable: true,
        get: () => inner,
        set(v) {
          inner = v;
          if (v instanceof Object) {
            try {
              trap(v, rest);
            } catch {}
          }
        },
      });
