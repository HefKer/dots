// Per-host niri settings for desktop: two 1080p screens at scale 1, a mouse.
// Linked to ~/.config/niri-host.kdl by the nixos flake; config.kdl includes that name.

layout {
    gaps 16

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }
}

// Screenshot windows (the claude-shot rule in config.kdl) open on the screen named in their
// app-id, which the opener sets to the screen you aren't focused on.
window-rule {
    match app-id="^claude-shot-DP-1$"
    open-on-output "DP-1"
}
window-rule {
    match app-id="^claude-shot-DP-3$"
    open-on-output "DP-3"
}

// The left screen keeps chat and the browser; the main one (DP-3) keeps config.kdl's
// numbered workspaces, 1 being whatever is in progress.
workspace "chat" {
    open-on-output "DP-1"
}
workspace "web" {
    open-on-output "DP-1"
}
// Kept even when empty, like DP-3's, so Mod+3-0 on this screen reach workspace 3-10 without
// filling the ones before. Names are global, hence the prefix; Mod+N goes by position.
workspace "left-3" { open-on-output "DP-1"; }
workspace "left-4" { open-on-output "DP-1"; }
workspace "left-5" { open-on-output "DP-1"; }
workspace "left-6" { open-on-output "DP-1"; }
workspace "left-7" { open-on-output "DP-1"; }
workspace "left-8" { open-on-output "DP-1"; }
workspace "left-9" { open-on-output "DP-1"; }
workspace "left-10" { open-on-output "DP-1"; }

spawn-at-startup "spotify"
spawn-at-startup "vesktop"
spawn-at-startup "qutebrowser"
spawn-at-startup "wezterm"

// spotify | vesktop side by side on chat, wherever they're opened.
window-rule {
    match app-id="^spotify$"
    match app-id="^vesktop$"
    open-on-workspace "chat"
    default-column-width { proportion 0.5; }
}
// Only the startup browser and terminal are placed; at-startup covers niri's first 60 s,
// so later windows open where you are.
window-rule {
    match app-id="^org\\.qutebrowser\\.qutebrowser$" at-startup=true
    open-on-workspace "web"
}
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$" at-startup=true
    open-on-workspace "1"
}
