# Syncthing global ignore patterns
# Include from per-folder .stignore via:  #include ~/.stglobalignore
# Syntax: https://docs.syncthing.net/users/ignoring.html
# Prefix: ! = include (override), (?i) = case-insensitive, (?d) = deletable

// ===== OS junk =====
(?d).DS_Store
(?d)._*
(?d).Spotlight-V100
(?d).Trashes
(?d).fseventsd
(?d).TemporaryItems
(?d).AppleDouble
(?d).LSOverride
(?d)Thumbs.db
(?d)Thumbs.db:encryptable
(?d)ehthumbs.db
(?d)ehthumbs_vista.db
(?d)Desktop.ini
(?d)$RECYCLE.BIN
(?d).directory
(?d).Trash-*
(?d)*~
(?d).nfs*

