# python
__pycache__/

# other
*.backup*
*.sync-conflict-*
.stfolder/
.stignore

# Application-written state. These files live in the dotfiles root because the
# config directories are linked whole; they are not authored here.

# niri — DMS regenerates this from the live compositor, so it is per-host
niri/.config/niri/dms/outputs.kdl

# kanata — misfire notes may quote private text; kanata-flag writes them
kanata/misfires.md

# qutebrowser — the directories download-file may move a download into; private
qutebrowser/.config/qutebrowser/download-dirs

# fish — universal variables, rewritten at runtime
fish/.config/fish/fish_variables

# DMS — upgrade markers and plugin-manager state (git clones, symlinks, meta)
DankMaterialShell/.config/DankMaterialShell/.firstlaunch
DankMaterialShell/.config/DankMaterialShell/.changelog-*
DankMaterialShell/.config/DankMaterialShell/plugins/*
# lidAwake, soundboard, micStatus and alarms are mine, not plugin-manager clones
!DankMaterialShell/.config/DankMaterialShell/plugins/lidAwake/
!DankMaterialShell/.config/DankMaterialShell/plugins/soundboard/
!DankMaterialShell/.config/DankMaterialShell/plugins/micStatus/
!DankMaterialShell/.config/DankMaterialShell/plugins/alarms/
# DMS — input.kdl is regenerated from settings.json on start; it still syncs.
niri/.config/niri/dms/input.kdl

# qutebrowser
autoconfig.yml
urls
QtProject.conf
quickmarks
/qutebrowser/.config/qutebrowser/quickmarks.old
/qutebrowser/.config/qutebrowser/docs
/helium
/.stglobalignore

# claude — the global ignore drops /.claude entirely; keep the repo-specific
# skills, which are authored here. Git never looks inside an ignored directory,
# so /.claude itself has to be re-included before skills/ can be.
!/.claude/
/.claude/*
!/.claude/skills/
/qutebrowser/.local/share/qutebrowser/userscripts/qutewarden
/qutebrowser/.local/share/qutebrowser/userscripts/aniqute

# proxy — the direct-sites list names banks, school and other sites I use
/proxy/direct.txt

# qutebrowser — osugacha capture userscript, a symlink into ~/dev/_osu/osugacha (that repo owns it)
qutebrowser/.config/qutebrowser/greasemonkey/osugacha-capture.js
# qutebrowser — osugacha page capture (osug-tile), a symlink into ~/dev/_osu/osugacha (that repo owns it)
qutebrowser/.config/qutebrowser/userscripts/osug-tile
