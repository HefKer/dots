# f+j: Esc, pressed together from idle, either order.
in: d:f t:10 d:j t:50 u:j t:10 u:f
out: <escape>
in: d:j t:10 d:f t:50 u:f t:10 u:j
out: <escape>
# Typed mid-word (within chords-v2-min-idle of a key): letters, no chord.
in: d:a t:50 u:a t:30 d:f t:10 d:j t:50 u:j t:10 u:f
out: afj
# Held apart past the chord window: f is Shift, as before.
in: d:f t:250 d:j t:30 u:j t:30 u:f
out: J
# Off in passthrough: letters.
in: d:lsft t:30 d:rsft t:30 d:esc t:30 u:esc t:30 u:rsft u:lsft t:300 d:f t:10 d:j t:50 u:j t:10 u:f
out: <S>fj
