;; Shared keymap body for every kanata instance; each instance's defcfg (devices,
;; process-unmapped-keys) is generated by the NixOS config, which includes this file.
;; Edit, then press Fn2+\ (lrld) to live-reload.

(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet menu rctl
)

;; The layer a manual passthrough-off or Fn Lock-off returns to.
;; Set to base when the HRM block is removed.
(defvar home hrm)

;; ---- HRM: delete this block (and set home to base) to drop home-row mods ----

(defhands
  (left  1 2 3 4 5 q w e r t a s d f g z x c v b)
  (right 6 7 8 9 0 - = y u i o p [ ] \ h j k l ; ' n m , . /))

(defvar
  hrm-timeout 200
  hrm-idle    150
  ;; A same-hand mod waits instead of tapping, so a+f still chords to Super+Shift.
  left-mods  (neutral-keys a s d f)
  right-mods (neutral-keys j k l ;))

;; -release: an opposite-hand key must go down and up while held, so a roll (f↓ o↓ f↑) stays "fo".
(deftemplate hrm (key mod mods)
  (tap-hold-opposite-hand-release $hrm-timeout $key $mod
    (same-hand tap) (timeout hold) (require-prior-idle $hrm-idle) $mods))

;; lalt, not ralt, on the right too: ralt turns AltGr under an intl xkb variant.
(defalias
  hra (t! hrm a lmet $left-mods)   hrs (t! hrm s lalt $left-mods)
  hrd (t! hrm d lctl $left-mods)   hrf (t! hrm f lsft $left-mods)
  hrj (t! hrm j rsft $right-mods)  hrk (t! hrm k rctl $right-mods)
  hrl (t! hrm l lalt $right-mods)  hr; (t! hrm ; rmet $right-mods))

;; First layer defined, so the one kanata starts on.
(deflayermap (hrm)
  esc @esc  caps @cap
  a @hra  s @hrs  d @hrd  f @hrf
  j @hrj  k @hrk  l @hrl  ; @hr;)

;; ---- end HRM ----

(defalias
  cap (tap-hold-release 200 200 esc (layer-while-held fn1))
  ;; Both physical Shifts + Esc toggles passthrough, independent of the osu watcher; HRM's f+j shifts don't count.
  esc (switch
        ((and (input real lsft) (input real rsft) (base-layer passthrough))) (layer-switch $home) break
        ((and (input real lsft) (input real rsft))) (layer-switch passthrough) break
        () esc break)
  fn2 (layer-while-held fn2)
  ;; Fn Lock: keeps Fn1 on until pressed again.
  fnl (switch
        ((base-layer fn1)) (layer-switch $home) break
        () (layer-switch fn1) break)
)

;; Stock keys except Caps; unmapped keys fall through to defsrc.
(deflayermap (base)
  esc @esc  caps @cap)

;; Hold Caps. Ported from the Wootility "Typing Profile".
(deflayermap (fn1)
  esc grv  1 f1  2 f2  3 f3  4 f4  5 f5  6 f6  7 f7  8 f8  9 f9  0 f10  - f11  = f12  bspc del
  tab @fn2  q pgdn  w up  e pgup  r caps  \ ins
  caps @cap  a left  s down  d rght  h home  j down  k up  l end  ' ins
  z ret  x prnt  c mlft  v mrgt
  ralt ralt  rmet menu  menu menu  rctl rctl)

;; Hold Tab inside Fn1.
(deflayermap (fn2)
  esc ret  1 prev  2 pp  3 next
  q home  w del  e end  r prnt  \ lrld
  h f19  j f20  k f21
  b f16  n f17  m f18
  / up  ralt left  rmet down  menu down  rctl rght
  rsft @fnl)

;; Every key stock, no tap-hold; the osu watcher's target. Esc keeps the manual toggle.
(deflayermap (passthrough)
  esc @esc)
