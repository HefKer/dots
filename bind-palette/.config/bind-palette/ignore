# wm: workspace numbers, the arrow/Page/Home/End and wheel twins of hjkl, hjkl/ui themselves, and the basics.
~^wm	Mod\+(Shift\+)?(Ctrl\+)?[0-9]	
~^wm	[^	]*(Left|Right|Up|Down|Page_Up|Page_Down|Home|End)	
~^wm	[^	]*WheelScroll
~^wm	Mod\+(Shift\+)?(Ctrl\+)?[HJKLUI]	
~^wm	Mod\+(Q|Return|Tab|F|Shift\+F|Minus|Equal|Shift\+Minus|Shift\+Equal)	
# shell: launcher, clipboard, region copy, settings.
~^shell	(Mod\+Space|Mod\+V|Print|Mod\+Comma)	
# kanata: home-row mods, Fn1's number row (F-keys) and hjkl (Home/Down/Up/End).
~^kanata	Hold 
~^kanata	Fn1\+([0-9=-]|Escape)	
~^kanata	Fn1\+[HJKL]	
# qutebrowser: readline and completion in the command line and prompts, tab numbers, vim basics, browser conventions.
~^qutebrowser	(command|prompt|yesno|register): 
~^qutebrowser	<Alt\+[0-9]>	
~^qutebrowser	[hjklGnNdurRHLJKoOT/?:]	
~^qutebrowser	(gg|yy|ZQ|ZZ|\+|-|=)	
~^qutebrowser	<(Ctrl\+t|Ctrl\+w|Ctrl\+Shift\+t|F5|Ctrl\+F5|F11|Back|Forward|Ctrl\+PgUp|Ctrl\+PgDown|Ctrl\+f|Ctrl\+b|Ctrl\+d|Ctrl\+u|Ctrl\+q)>	
~^qutebrowser	(hint|insert|passthrough): <(Escape|Return)>	
# nvim: built-in defaults, the [x ]x list family, scroll/increment, LSP defaults, and LazyVim's basics.
~^nvim	[^	]*	:help 
~^nvim	[^	]*	:(c|l|t|pt)?(next|prev|previous|first|last|rewind|pfile|nfile)$
~^nvim	([ioxc]: )?<lt>C-[FBAX]>	
~^nvim	[^	]*	vim\.lsp\.buf\.
~^nvim	(x: )?(p|P|y|gc|gcc|gx|H|L|\]b|\[b|\]d|\[d)	
~^nvim	<Space>(<Space>|ff|/|e|,|:)	
