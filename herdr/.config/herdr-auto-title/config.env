# herdr-auto-title, read once at startup (restart: herdr's "Auto Title: restart" action).
# Every setting: https://github.com/kryptamine/herdr-auto-title/blob/main/config.env.example

# Name a tab, and its space's $topic, after its agent pane even while another pane
# is focused, so the prompt pane (scripts/claude-prompt) zoomed over Claude doesn't
# turn them into "exec nvim".
HERDR_AUTO_TITLE_PREFER_AGENT=true

# Tab labels fit many to a row: Claude's title cut back to a word within 12 columns,
# the tab's position added on top. The flake's patch keeps pane labels (goto's rows)
# whole, and $topic is never bounded, so the full title stays in goto and the sidebar.
HERDR_AUTO_TITLE_MAX_LENGTH=12

# A tab without an agent is named for its program alone; its pane label keeps the directory.
HERDR_AUTO_TITLE_DIRECTORY_MAX=0
