# herdr-auto-title, read once at startup (restart: herdr's "Auto Title: restart" action).
# Every setting: https://github.com/kryptamine/herdr-auto-title/blob/main/config.env.example

# Name a tab, and its space's $topic, after its agent pane even while another pane
# is focused, so the prompt pane (scripts/claude-prompt) zoomed over Claude doesn't
# turn them into "exec nvim".
HERDR_AUTO_TITLE_PREFER_AGENT=true
